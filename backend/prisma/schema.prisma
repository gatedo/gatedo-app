generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  phone                  String?
  password               String
  name                   String?
  tutorTitle             String                 @default("TUTOR")
  photoUrl               String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  status                 String                 @default("ACTIVE")
  badges                 String[]               @default([])
  city                   String?
  plan                   String                 @default("FREE")
  planExpires            DateTime?
  role                   Role                   @default(USER)
  emailVerified          Boolean                @default(false)
  emailVerifyToken       String?                @unique
  resetPasswordExpires   DateTime?
  resetPasswordToken     String?                @unique
  level                  Int                    @default(1)
  founderBonusMonthsPaid Int                    @default(0)
  founderGrantedAt       DateTime?
  gatedoPoints           Int                    @default(0)
  xpt                    Int                    @default(0)
  signupSource           String?
  // Bloco "Apoie o GATEDO" (Perfil + pós-PDF) — nunca contrapartida, só timing.
  donationPromptSeenAt   DateTime?
  donationDismissedAt    DateTime?
  // Tour de boas-vindas: 0 nunca começou, 1 boas-vindas vista, 2 gato
  // cadastrado, 3 peso registrado, 4 Saúde mostrada, 5 concluído (selo dado).
  onboardingStep         Int       @default(0)
  onboardingCompletedAt  DateTime?
  lastLoginAt            DateTime?
  // Origem do primeiro toque (LP/app), capturada no navegador antes do
  // cadastro e gravada aqui uma única vez — nunca sobrescrita depois.
  // Formato: { anonId, utmSource, utmMedium, utmCampaign, utmContent, referrer, capturedAt }
  firstTouch             Json?
  // Preferências de lembretes de cuidado (Perfil → Lembretes).
  remindersPushEnabled   Boolean   @default(true)
  remindersEmailEnabled  Boolean   @default(true)
  reminderPreferredTime  String    @default("MORNING") // MORNING | AFTERNOON
  lastReminderEmailAt    DateTime?
  reminders              Reminder[]
  pushSubscriptions      PushSubscription[]
  balanceActionsMade     BalanceAdjustmentLog[] @relation("BalanceActor")
  balanceLogs            BalanceAdjustmentLog[] @relation("BalanceTarget")
  comments               Comment[]
  targetCoupons          Coupon[]               @relation("CouponTarget")
  couponRedemptions      CouponRedemption[]
  documents              Document[]
  memorialTributes       MemorialTribute[]
  notifications          Notification[]
  orders                 Order[]
  pets                   Pet[]
  petAchievements        PetAchievement[]       @relation("PetAchievementGrantedByUser")
  posts                  Post[]
  postLikes              PostLike[]
  postSaves              PostSave[]
  productShares          ProductShare[]
  rewardEvents           RewardEvent[]
  socialFollows          SocialFollow[]         @relation("SocialFollowFollower")
  petFollowers           SocialFollow[]         @relation("SocialFollowPetOwner")
  studioCreations        StudioCreation[]
  subscription           Subscription?
  tutorPoints            TutorPoints?
  achievements           UserAchievement[]
  credits                UserCredits?
  vetProfile             VetPartner?
  vetRecommendations     VetRecommendation[]
  noticeReads            NoticeRead[]
  igentUsageLogs         IgentUsageLog[]
  protocolEnrollments    ProtocolEnrollment[]
  productEntitlements    ProductEntitlement[]
  offerEvents            OfferEvent[]
  events                 Event[]
  ongProfile             OngProfile?
  transferInvitesSent    PetTransferInvite[]    @relation("OngTransferInvites")
  transferInvitesAccepted PetTransferInvite[]   @relation("AcceptedTransferInvites")
  ongSuggestions         OngSuggestion[]
}

model Pet {
  id                    String              @id @default(uuid())
  ownerId               String
  name                  String
  nicknames             String?
  breed                 String?
  themeColor            String?
  photoUrl              String?
  gallery               String[]
  gender                Gender              @default(UNKNOWN)
  birthDate             DateTime?
  deathDate             DateTime?
  isDateEstimated       Boolean             @default(false)
  ageYears              Int?
  ageMonths             Int?
  weight                Float?
  city                  String?
  microchip             String?
  neutered              Boolean             @default(false)
  neuterIntention       String?
  healthSummary         String?
  foodBrand             String?
  foodFreq              String?
  foodType              String[]
  personality           String[]
  activityLevel         String?
  socialOtherPets       String?
  behaviorIssues        String?
  traumaHistory         String?
  housingType           String?
  streetAccess          Boolean             @default(false)
  adoptionStory         String?
  hasAwards             Boolean             @default(false)
  awardsDetail          String?
  isArchived            Boolean             @default(false)
  isMemorial            Boolean             @default(false)
  showInHome            Boolean             @default(true)
  // Transferência de tutoria (ONGs) — status só é significativo quando o
  // dono atual é uma ONG; adoptionStatus: DISPONIVEL | EM_PROCESSO | ADOTADO.
  adoptionStatus        String?
  // Anotações internas da ONG sobre o gato — NUNCA acompanha a transferência.
  // Zerado no aceite (o conteúdo vai pro snapshot da ONG antes disso).
  ongInternalNotes      String?
  level                 Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bio                   String?
  foodAmount            String?
  pedigreeUrl           String?
  skillAgility          String              @default("85")
  skillCuriosity        String              @default("90")
  skillDocile           String              @default("95")
  skillEnergy           String              @default("75")
  skillIndep            String              @default("60")
  skillSocial           String              @default("80")
  habitat               String?
  riskAreaAccess        Boolean             @default(false)
  deathCause            String?
  pedigreeBackUrl       String?
  badges                String[]            @default([])
  xpg                   Int                 @default(0)
  arrivalNotes          String?
  arrivalType           String?
  coatType              String?
  coexistsWith          String[]            @default([])
  feedFrequencyMode     String?
  feedFrequencyNotes    String?
  hasBehaviorIssues     Boolean             @default(false)
  hasTraumaHistory      Boolean             @default(false)
  preExistingConditions String[]            @default([])
  profileCompletedAt    DateTime?
  diaryEntries          DiaryEntry[]
  documents             Document[]
  healthRecords         HealthRecord[]
  reminders             Reminder[]
  igentSessions         IgentSession[]
  igentUsageLogs        IgentUsageLog[]
  protocolEnrollments   ProtocolEnrollment[]
  memorial              MemorialTribute?
  owner                 User                @relation(fields: [ownerId], references: [id])
  achievements          PetAchievement[]
  posts                 Post[]
  rewardEvents          RewardEvent[]
  followers             SocialFollow[]
  studioCreations       StudioCreation[]
  treatments            TreatmentSchedule[]
  offerEvents           OfferEvent[]
  transferInvites       PetTransferInvite[]
}

// ═══════════════════════════════════════════════════════════════════════
// ONGs DE ADOÇÃO — conta gratuita, painel multi-gato, transferência de tutoria
// ═══════════════════════════════════════════════════════════════════════

model OngProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  name              String
  cnpjOuResponsavel String
  city              String?
  instagram         String?
  // PENDING (aguardando aprovação) | APPROVED | REJECTED
  status            String    @default("PENDING")
  requestedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectionReason   String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Convite de transferência de tutoria — por gato, com validade de 7 dias.
// O aceite é o próprio consentimento: acceptedAt marca as duas coisas.
model PetTransferInvite {
  id               String    @id @default(uuid())
  petId            String
  ongUserId        String
  token            String    @unique
  // PENDING | ACCEPTED | EXPIRED | CANCELLED
  status           String    @default("PENDING")
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  acceptedAt       DateTime?
  acceptedByUserId String?
  // Registro congelado no instante do aceite — inclui o que a ONG NÃO pode
  // mais acessar depois (ex.: ongInternalNotes), pra ela manter memória do
  // que ficou pra trás sem manter acesso ao histórico novo do gato.
  ongSnapshot      Json?
  pet              Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  ongUser          User      @relation("OngTransferInvites", fields: [ongUserId], references: [id])
  acceptedByUser   User?     @relation("AcceptedTransferInvites", fields: [acceptedByUserId], references: [id])

  @@index([petId])
  @@index([ongUserId])
  @@index([status])
}

// Sugestões/pedidos de melhoria enviados pelas ONGs parceiras — lidas no admin.
model OngSuggestion {
  id        String   @id @default(uuid())
  userId    String
  message   String
  status    String   @default("NEW") // NEW | SEEN
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model HealthRecord {
  id                 String     @id @default(uuid())
  petId              String
  type               HealthType
  title              String
  date               DateTime
  nextDueDate        DateTime?
  batchNumber        String?
  veterinarian       String?
  clinic             String?
  notes              String?
  attachmentUrl      String?
  active             Boolean    @default(false)
  appointmentMode    String?
  clinicAddress      String?
  clinicName         String?
  clinicPhone        String?
  isControlled       Boolean    @default(false)
  ongoing            Boolean    @default(false)
  prescription       Boolean    @default(false)
  prescriptionDocId  String?
  reason             String?
  recheckDate        DateTime?
  recommendedRecheck Boolean    @default(false)
  specialty          String?
  pet                Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model IgentSession {
  id               String    @id @default(uuid())
  petId            String
  date             DateTime  @default(now())
  symptomId        String
  symptomLabel     String
  isUrgent         Boolean
  analysisText     String
  recommendations  Json
  clinicalSnapshot Json
  ownerResponse    String?
  resolvedAt       DateTime?
  severity         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pet              Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model IgentUsageLog {
  id           String   @id @default(cuid())
  userId       String
  petId        String?
  action       String   @default("QUESTION")
  provider     String?
  tokensUsed   Int?
  costEstimate Float?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet          Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([petId, createdAt])
}

// Rastreio de impressão/clique/conversão do motor único de decisão de oferta,
// sempre com a superfície de origem (regra dura: toda oferta registra os 3).
model OfferEvent {
  id        String   @id @default(cuid())
  userId    String
  petId     String?
  surface   String
  offerKey  String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet       Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([offerKey, action])
  @@index([surface, action])
}

// Funil de ativação/retenção do produto — evento genérico de uso, front e
// back-end. user_id nulo = visitante ainda não cadastrado, ligado depois ao
// anon_id salvo no navegador. Nunca guardar texto livre/PII em props — só
// ids, tipos e números (ver events.service.ts#track).
model Event {
  id          String   @id @default(cuid())
  userId      String?
  anonId      String?
  name        String
  props       Json?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId])
  @@map("events")
}

// Próxima data de cuidado (vermífugo, antipulgas, vacina, medicação contínua,
// pesagem) — vira o bloco "Próximos cuidados" e dispara push/e-mail.
// notifyCount conta quantos avisos já saíram pra esse lembrete (rege o teto
// de 3 avisos de atraso e o "1 aviso no dia seguinte, depois 1 por semana").
model Reminder {
  id             String    @id @default(cuid())
  userId         String
  petId          String
  type           String // VERMIFUGE | PARASITE | VACCINE | MEDICATION | WEIGHT
  dueDate        DateTime
  status         String    @default("pendente") // pendente | feito | adiado | cancelado
  sourceRecordId String?
  notifiedAt     DateTime?
  notifyCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet            Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
  @@index([petId, status, dueDate])
  @@map("reminders")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════
// MÓDULO DE CONTEÚDO — dois tipos: Guia (livre) e Protocolo (com entitlement)
// ═══════════════════════════════════════════════════════════════════════

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// ── GUIA (almanaque) — navegável por tema/busca, sem trava, sem XP ──────
enum GuideUrgency {
  ROTINA
  ATENCAO
  EMERGENCIA
}

// Categoria do almanaque — id vem direto do JSON de origem (ex.: "caixa").
model GuideCategory {
  id        String       @id
  nome      String
  descricao String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  entries   GuideEntry[]
}

model GuideEntry {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  theme            String
  categoryId       String?
  category         GuideCategory? @relation(fields: [categoryId], references: [id])
  excerpt          String?
  body             String
  // Conteúdo rico opcional (seções coloridas, imagem, checklist, callout,
  // slot de oferta) — array de blocos tipados. Quando ausente/vazio, o
  // front cai pro `body` em markdown simples (compat com verbetes antigos).
  blocks           Json?
  tags             String[]      @default([])
  urgency          GuideUrgency?
  vejaTambem       String[]      @default([])
  perguntaIgentvet String?
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([theme])
  @@index([status])
  @@index([categoryId])
}

// ── PROTOCOLO — triagem (D0) + N dias + fechamento, requer entitlement ──
model Protocol {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  summary             String?
  requiresFounder     Boolean       @default(true)
  totalDays           Int
  status              ContentStatus @default(DRAFT)
  // Protocolos "ricos" (triagem com blocos, checklist, campos tipados,
  // fechamento com cenários) guardam o JSON de origem aqui, intacto —
  // reimportar troca só este campo, nunca as tabelas de progresso.
  spec                Json?
  // Quando setado, o acesso é por ProductEntitlement (produto Kiwify),
  // não pelo tier founder/pro — substitui requiresFounder para este protocolo.
  entitlementProductId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  steps               ProtocolStep[]
  enrollments         ProtocolEnrollment[]

  @@index([status])
}

enum ProtocolStepKind {
  TRIAGE
  DAY
  CLOSING
}

// dayNumber: 0 = triagem, 1..N = dias, N+1 = fechamento
model ProtocolStep {
  id         String           @id @default(cuid())
  protocolId String
  kind       ProtocolStepKind
  dayNumber  Int
  title      String
  taskShort  String?
  whyText    String?
  asksRating Boolean          @default(false)
  protocol   Protocol         @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@unique([protocolId, dayNumber])
}

enum ProtocolEnrollmentStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
  INTERROMPIDO_EMERGENCIA
}

model ProtocolEnrollment {
  id             String                   @id @default(cuid())
  protocolId     String
  userId         String
  petId          String
  status         ProtocolEnrollmentStatus @default(EM_ANDAMENTO)
  currentDay     Int                      @default(0)
  startedAt      DateTime                 @default(now())
  completedAt    DateTime?
  resolved       Boolean?
  // Respostas da triagem (blocos "emergencia"/"veterinario" e quaisquer outros do spec).
  triageAnswers  Json?
  // Tela "Como funciona" (bloco "apresentacao" do spec) — só aparece uma vez,
  // antes da triagem. Null = ainda não viu.
  presentationSeenAt DateTime?
  // tarefa_fixa do bloco veterinário ("nao" → agendar consulta) — visível em
  // todos os dias até ser marcada como concluída.
  fixedTaskDone  Boolean                  @default(false)
  protocol       Protocol                 @relation(fields: [protocolId], references: [id])
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet            Pet                      @relation(fields: [petId], references: [id], onDelete: Cascade)
  logs           ProtocolDayLog[]

  @@index([userId])
  @@index([petId])
}

model ProtocolDayLog {
  id            String             @id @default(cuid())
  enrollmentId  String
  dayNumber     Int
  unlockedAt    DateTime           @default(now())
  completedAt   DateTime?
  note          String?
  severityScore Int?
  advancedEarly Boolean            @default(false)
  // Itens de checklist marcados: { "itemId": true|false }
  checklist     Json?
  enrollment    ProtocolEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  entries       ProtocolDayEntry[]

  @@unique([enrollmentId, dayNumber])
}

// Uma linha por registro salvo — cobre "repetivel" (várias ocorrências no
// mesmo dia) guardando os campos tipados do spec como vieram.
model ProtocolDayEntry {
  id        String         @id @default(cuid())
  dayLogId  String
  data      Json
  createdAt DateTime       @default(now())
  dayLog    ProtocolDayLog @relation(fields: [dayLogId], references: [id], onDelete: Cascade)

  @@index([dayLogId])
}

// ═══════════════════════════════════════════════════════════════════════
// ENTITLEMENTS DE PRODUTO — liberação de produtos externos (Kiwify) por e-mail
// ═══════════════════════════════════════════════════════════════════════

// Produto liberado para um usuário já cadastrado.
model ProductEntitlement {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  source     String   @default("KIWIFY")
  externalId String?
  grantedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([externalId])
}

// Compra aprovada para um e-mail que ainda não tem conta — aplicada no primeiro login/cadastro.
model PendingProductEntitlement {
  id         String   @id @default(cuid())
  email      String
  productId  String
  source     String   @default("KIWIFY")
  externalId String?
  createdAt  DateTime @default(now())

  @@index([email])
}

model AdminKnowledgeSection {
  id          String   @id @default(uuid())
  slug        String   @unique
  scope       String   @default("IGENT_FELINE_ALMANAC")
  title       String
  content     String
  excerpt     String?
  tags        String[] @default([])
  metadata    Json?
  status      String   @default("PUBLISHED")
  version     Int      @default(1)
  active      Boolean  @default(true)
  source      String   @default("ADMIN")
  reviewedBy  String?
  reviewedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope])
  @@index([status])
  @@index([active])
}

model Document {
  id              String    @id @default(uuid())
  petId           String
  type            String?
  category        String
  cloudExportedAt DateTime?
  cloudPath       String?
  cloudProvider   String?
  createdAt       DateTime  @default(now())
  fileName        String?
  fileUrl         String
  isFavorite      Boolean   @default(false)
  isPrivate       Boolean   @default(true)
  isVetShared     Boolean   @default(false)
  metadata        Json?
  mimeType        String?
  ownerId         String
  size            Int?
  title           String
  updatedAt       DateTime  @updatedAt
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pet             Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([ownerId])
  @@index([category])
  @@index([createdAt])
}

model MemorialTribute {
  id          String   @id @default(uuid())
  userId      String
  petId       String?  @unique
  name        String
  birthYear   String?
  deathYear   String?
  message     String
  photoUrl    String?
  candleCount Int      @default(0)
  createdAt   DateTime @default(now())
  isPublic    Boolean  @default(true)
  title       String?
  pet         Pet?     @relation(fields: [petId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Post {
  id               String          @id @default(uuid())
  userId           String
  content          String
  imageUrl         String?
  likes            Int             @default(0)
  createdAt        DateTime        @default(now())
  allowComments    Boolean         @default(true)
  allowShare       Boolean         @default(true)
  commentsCount    Int             @default(0)
  featured         Boolean         @default(false)
  petId            String
  savesCount       Int             @default(0)
  sharesCount      Int             @default(0)
  source           String          @default("manual")
  type             String          @default("PHOTO")
  updatedAt        DateTime        @updatedAt
  visibility       PostVisibility  @default(PUBLIC)
  studioCreationId String?
  comments         Comment[]
  pet              Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  studioCreation   StudioCreation? @relation(fields: [studioCreationId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  likedBy          PostLike[]
  savedBy          PostSave[]

  @@index([petId, visibility, createdAt])
  @@index([studioCreationId])
  @@index([userId, createdAt])
  @@index([visibility, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([postId, createdAt])
}

model SocialFollow {
  id         String   @id @default(uuid())
  followerId String
  ownerId    String
  petId      String
  createdAt  DateTime @default(now())
  follower   User     @relation("SocialFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  owner      User     @relation("SocialFollowPetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([followerId, petId])
  @@index([petId])
  @@index([ownerId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostSave {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Achievement {
  id          String               @id @default(uuid())
  title       String
  description String
  iconUrl     String?
  condition   String
  active      Boolean              @default(true)
  category    String?
  code        String               @unique
  pointReward Int                  @default(0)
  rarity      String?              @default("common")
  ownerType   AchievementOwnerType
  xpgReward   Int                  @default(0)
  xptReward   Int                  @default(0)
  pets        PetAchievement[]
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  meta          Json?
  rarity        String?
  source        String?
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model PetAchievement {
  id              String      @id @default(uuid())
  petId           String
  achievementId   String
  grantedByUserId String?
  unlockedAt      DateTime    @default(now())
  rarity          String?
  source          String?
  meta            Json?
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  grantedByUser   User?       @relation("PetAchievementGrantedByUser", fields: [grantedByUserId], references: [id])
  pet             Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, achievementId])
  @@index([petId, unlockedAt])
}

model DiaryEntry {
  id          String   @id @default(uuid())
  petId       String
  title       String
  content     String?
  date        DateTime @default(now())
  type        String
  photos      String[]
  // Ocorrências estruturadas marcadas pelo tutor (ex.: "URINARY_ACCIDENT" —
  // xixi fora da caixa). Usado pelo motor de decisão de oferta pra detectar
  // o contexto de dor sem depender de busca por palavra-chave em texto livre.
  occurrences String[] @default([])
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model StudioCreation {
  id                  String               @id @default(uuid())
  userId              String
  type                StudioType
  originalPhotoUrl    String?
  createdAt           DateTime             @default(now())
  petId               String?
  addedToPetGalleryAt DateTime?
  metadata            Json?
  moduleKey           String?
  moduleLabel         String?
  outputImageUrl      String?
  outputVideoUrl      String?
  previewUrl          String?
  prompt              String?
  publishedAt         DateTime?
  sourceImageUrls     String[]             @default([])
  status              StudioCreationStatus @default(COMPLETED)
  updatedAt           DateTime             @updatedAt
  socialPosts         Post[]
  pet                 Pet?                 @relation(fields: [petId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([petId, createdAt])
  @@index([type, createdAt])
}

model VetRecommendation {
  id         String   @id @default(uuid())
  userId     String
  name       String
  clinicName String?
  address    String?
  city       String?
  phone      String?
  rating     Float    @default(5.0)
  tags       String[]
  isVerified Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id])
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Product {
  id            String         @id @default(uuid())
  categoryId    String
  name          String
  description   String
  price         Decimal        @db.Decimal(10, 2)
  promoPrice    Decimal?       @db.Decimal(10, 2)
  images        String[]
  isDigital     Boolean        @default(false)
  externalLink  String?
  stock         Int            @default(0)
  platform      String?
  badge         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  videoReview   String?
  // Tags de perfil do gato pra recomendação da Loja (ex.: "urinary",
  // "kitten", "senior", "longhair") — marcadas manualmente pelo admin.
  tags          String[]       @default([])
  // Produto digital próprio (ebook etc.) liberado por ProductEntitlement,
  // mesmo mecanismo que os protocolos pagos já usam — dá "Você tem" no bloco
  // "Do GATEDO" da Loja sem precisar de um sistema de posse novo.
  entitlementProductId String?
  orderItems    OrderItem[]
  category      Category       @relation(fields: [categoryId], references: [id])
  productShares ProductShare[]
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Article {
  id        String   @id @default(uuid())
  title     String
  category  String
  imageUrl  String?
  content   String
  author    String   @default("Equipe Gatedo")
  createdAt DateTime @default(now())
}

model StudioAsset {
  id        String   @id @default(uuid())
  title     String
  type      String
  url       String
  isPro     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VetPartner {
  id         String   @id @default(uuid())
  name       String
  clinicName String
  address    String
  phone      String?
  whatsapp   String?
  photoUrl   String?
  latitude   Float?
  longitude  Float?
  isVerified Boolean  @default(false)
  isPremium  Boolean  @default(false)
  tags       String[]
  rating     Float    @default(0.0)
  reviews    Int      @default(0)
  createdAt  DateTime @default(now())
  ownerId    String?  @unique
  status     String   @default("PENDING")
  owner      User?    @relation(fields: [ownerId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  message     String
  read        Boolean  @default(false)
  petId       String?
  catName     String?
  catBreed    String?
  catPhotoUrl String?
  cta         String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model BalanceAdjustmentLog {
  id          String   @id @default(uuid())
  userId      String
  actorId     String?
  walletDelta Int      @default(0)
  xpDelta     Int      @default(0)
  reason      String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("BalanceActor", fields: [actorId], references: [id])
  user        User     @relation("BalanceTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
}

model TutorPoints {
  id           String   @id @default(uuid())
  userId       String   @unique
  points       Int      @default(0)
  totalEarned  Int      @default(0)
  lastActionAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TreatmentSchedule {
  id                           String          @id @default(uuid())
  petId                        String
  userId                       String
  title                        String
  notes                        String?
  intervalHours                Int
  startDate                    DateTime
  endDate                      DateTime?
  active                       Boolean         @default(true)
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  clinicAddress                String?
  clinicName                   String?
  clinicPhone                  String?
  originHealthRecordId         String?
  originPrescriptionDocumentId String?
  veterinarian                 String?
  doses                        TreatmentDose[]
  pet                          Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model TreatmentDose {
  id          String            @id @default(uuid())
  scheduleId  String
  scheduledAt DateTime
  takenAt     DateTime?
  skipped     Boolean           @default(false)
  notes       String?
  createdAt   DateTime          @default(now())
  schedule    TreatmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model AppSettings {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model ProductShare {
  id        String   @id @default(uuid())
  userId    String
  productId String
  token     String   @unique @default(cuid())
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Kit {
  id         String   @id @default(uuid())
  title      String
  subtitle   String   @default("")
  iconName   String   @default("Gift")
  gradient   String   @default("from-yellow-400 to-orange-500")
  productIds String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Coupon {
  id           String             @id @default(uuid())
  code         String             @unique
  description  String
  discountType String             @default("POINTS")
  value        Int
  maxUses      Int                @default(1)
  usedCount    Int                @default(0)
  active       Boolean            @default(true)
  expiresAt    DateTime?
  targetUserId String?
  createdAt    DateTime           @default(now())
  targetUser   User?              @relation("CouponTarget", fields: [targetUserId], references: [id])
  redemptions  CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  userId     String
  redeemedAt DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
}

model UserCredits {
  id          String   @id @default(uuid())
  userId      String   @unique
  balance     Int      @default(0)
  totalBought Int      @default(0)
  totalUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FounderInvite {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  name      String?
  phase     Int
  orderId   String?
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Subscription {
  id         String    @id @default(uuid())
  userId     String    @unique
  provider   String    @default("KIWIFY")
  externalId String?
  planType   String
  status     String
  startedAt  DateTime  @default(now())
  expiresAt  DateTime?
  autoRenew  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FounderPhaseConfig {
  phase     Int      @id
  price     Decimal  @db.Decimal(10, 2)
  maxSlots  Int
  soldSlots Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id         String       @id @default(uuid())
  title      String
  xpReward   Int          @default(3)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  content    String
  imageUrl   String?
  isActive   Boolean      @default(true)
  type       String       @default("INFO")
  updatedAt  DateTime     @updatedAt
  // Push (alerta sonoro no aparelho) é opcional por comunicado — desmarcar
  // pra publicidade interna discreta que só deve aparecer dentro do app.
  // pushSentAt evita reenviar ao editar um comunicado já publicado.
  sendPush   Boolean      @default(true)
  pushSentAt DateTime?
  reads      NoticeRead[]
}

model NoticeRead {
  id          String    @id @default(uuid())
  userId      String
  noticeId    String
  readAt      DateTime  @default(now())
  xpGranted   Boolean   @default(false)
  xpGrantedAt DateTime?
  notice      Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId])
  @@index([noticeId])
  @@map("notice_reads")
}

model RewardEvent {
  id           String   @id @default(cuid())
  userId       String
  petId        String?
  action       String
  gptsDelta    Int      @default(0)
  xptDelta     Int      @default(0)
  xpgDelta     Int      @default(0)
  badgeGranted String?
  metadata     Json?
  createdAt    DateTime @default(now())
  pet          Pet?     @relation(fields: [petId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([petId, createdAt])
  @@index([action])
}

model Prospect {
  id            String            @id @default(cuid())
  phone         String
  name          String?
  note          String?
  status        String            @default("pending")
  column        String            @default("pending")
  score         Int               @default(0)
  tags          String[]
  sentAt        DateTime?
  repliedAt     DateTime?
  lastReply     String?
  lastMessageId String?
  scriptId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      ProspectMessage[]

  @@index([phone])
  @@index([status])
}

model ProspectMessage {
  id          String   @id @default(cuid())
  prospectId  String
  direction   String
  body        String
  imageUrl    String?
  waMessageId String?
  sentAt      DateTime @default(now())
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model ProspectTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String?
  color       String?
  labelColor  String?
  bubbleColor String?
  imageUrl    String?
  linkUrl     String?
  parentTheme String?
  flowCategory String?
  flowColor   String?
  stepOrder   Int      @default(1)
  delaySeconds Int     @default(0)
  message     String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([parentTheme, flowCategory, stepOrder])
  @@index([active])
}

model InstagramLead {
  id                       String                     @id @default(cuid())
  instagramUserId          String?                    @unique
  username                 String?
  fullName                 String?
  profileUrl               String?
  avatarUrl                String?
  source                   String                     @default("manual")
  status                   String                     @default("new")
  score                    Int                        @default(0)
  tags                     String[]                   @default([])
  notes                    String?
  consentStatus            String                     @default("unknown")
  lastInteractionAt        DateTime?
  conversationWindowUntil  DateTime?
  lastMessageAt            DateTime?
  lastReplyAt              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  interactions             InstagramInteraction[]
  messages                 InstagramMessage[]

  @@index([status])
  @@index([source])
  @@index([username])
  @@index([lastInteractionAt])
}

model InstagramInteraction {
  id                String        @id @default(cuid())
  leadId            String
  type              String
  mediaId           String?
  commentId         String?
  permalink         String?
  text              String?
  occurredAt        DateTime      @default(now())
  privateReplyUntil DateTime?
  metadata          Json?
  lead              InstagramLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([occurredAt])
}

model InstagramMessage {
  id             String        @id @default(cuid())
  leadId         String
  direction      String
  body           String
  templateId     String?
  metaMessageId  String?
  status         String        @default("draft")
  blockedReason  String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  lead           InstagramLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
}

model InstagramTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("outreach")
  body        String
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([category])
}

model InstagramComplianceLog {
  id        String   @id @default(cuid())
  action    String
  leadId    String?
  allowed   Boolean
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([action])
  @@index([createdAt])
}

model AdminVenture {
  id            String   @id
  title         String
  subtitle      String?
  stage         String?
  pipelineStage String   @default("Ideia")
  horizon       String?
  owner         String?
  score         Int      @default(0)
  impact        Int      @default(0)
  complexity    Int      @default(0)
  revenue       String?
  model         String?
  thesis        String?
  risk          String?
  revenueLines  String[] @default([])
  kpis          String[] @default([])
  partners      String[] @default([])
  nextMoves     String[] @default([])
  doneMoves     Int[]    @default([])
  note          String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pipelineStage])
  @@index([score])
  @@index([updatedAt])
}

model AdminCampaign {
  id        String   @id
  name      String
  type      String
  status    String   @default("Briefing")
  channels  String[] @default([])
  objective String?
  audience  String[] @default([])
  budget    String?
  deadline  String?
  formats   String[] @default([])
  hook      String?
  headline  String?
  cta       String?
  caption   String?
  assets    String[] @default([])
  notes     String?
  results   String?
  owner     String?
  kpis      String[] @default([])
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([updatedAt])
}

enum Role {
  USER
  ADMIN
  VET
  FOUNDER
  TESTER_VIP
  ONG
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum HealthType {
  VACCINE
  VERMIFUGE
  PARASITE
  MEDICATION
  EXAM
  SURGERY
  CONSULTATION
  IACONSULT
  MEDICINE
  ADOPTION
}

enum PostVisibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}

enum StudioType {
  PORTRAIT
  STICKER
  ID_CARD
  MIND_READER
  TUTOR_CAT
  DANCE
  CAT_VOICE
  ANIMATED_STORY
  MEME_MAKER
  VOGUE_CAT
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum AchievementOwnerType {
  TUTOR
  PET
}

enum StudioCreationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PUBLISHED
}
